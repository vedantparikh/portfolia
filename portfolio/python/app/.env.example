# Copy to .env.docker and fill in secrets. Never commit .env.docker.

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

POOL_SIZE=20
MAX_OVERFLOW=10
POOL_TIMEOUT=30
POOL_RECYCLE=3600

# Background worker: seconds between watchlist price/alert refreshes
WORKER_INTERVAL_SECONDS=900

# Redis (empty password = no auth; set one outside local dev)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Required when ENVIRONMENT=production. Redis reads it from the same env file.
REDIS_PASSWORD=

# API
# development, dev, local or test skip the secret check; anything else enforces it
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=info
API_URL=http://0.0.0.0:8000

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
# JWT_SECRET_KEY is the signing key. SECRET_KEY is used only when JWT_SECRET_KEY is unset.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Used when REFRESH_TOKEN_EXPIRE_MINUTES is unset (7 days = 10080 minutes).
REFRESH_TOKEN_EXPIRE_DAYS=7
# The refresh token is a Secure httpOnly cookie. false only for plain http on a host other than localhost.
REFRESH_COOKIE_SECURE=true

# Trade Republic export kept fresh by Bachat (compose mounts it at /pytr, read only).
# Only these usernames may link a portfolio to it. Empty path = feature off.
PYTR_EXPORT_PATH=
PYTR_SYNC_USERS=

# Market data
YAHOO_FINANCE_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_FROM=noreply@example.com

STATIC_DIR=STATICS
