[Unit]
Description=Restore the newest Portfolia dump into staging
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=bubbly
SupplementaryGroups=docker
WorkingDirectory=/home/bubbly/server/appdata/portfolia/portfolio
ExecStart=/home/bubbly/server/appdata/portfolia/portfolio/scripts/restore-drill.sh
TimeoutStartSec=60min
Nice=10
