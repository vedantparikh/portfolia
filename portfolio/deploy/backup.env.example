# Optional Nextcloud copy of the daily dump. Copy this file to
# /home/bubbly/server/appdata/portfolia/env/backup.env and chmod 600.
# Leave it absent to keep dumps only on disk. The password is a Nextcloud
# app password. This file is not read from the repo.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
