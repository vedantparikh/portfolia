# Production API. No reload, no bind mounts, migrations are a separate command.
# The dev image remains Dockerfile and is what docker-compose.yml builds.
FROM python:3.14.9-slim-trixie AS build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /opt/uv/uv
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN UV_PROJECT_ENVIRONMENT=/usr/local /opt/uv/uv sync --frozen --inexact --no-cache --no-dev

FROM python:3.14.9-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    WEB_CONCURRENCY=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home --shell /usr/sbin/nologin portfolia

COPY --from=build /usr/local /usr/local

WORKDIR /app
COPY --chown=portfolia:portfolia \
    __init__.py main.py config.py health_check.py alembic.ini portfolia.py ./
COPY --chown=portfolia:portfolia alembic ./alembic
COPY --chown=portfolia:portfolia api ./api
COPY --chown=portfolia:portfolia core ./core
COPY --chown=portfolia:portfolia modules ./modules
COPY --chown=portfolia:portfolia workers ./workers
COPY --chown=portfolia:portfolia utils ./utils
COPY --chown=portfolia:portfolia scripts ./scripts
COPY --chown=portfolia:portfolia STATICS ./STATICS
COPY entrypoint.prod.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh && chown portfolia:portfolia /app

USER portfolia
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/')"

ENTRYPOINT ["/entrypoint.sh"]
